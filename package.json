{
  "name": "oscillo",
  "productName": "Oscillo",
  "version": "0.1.0",
  "description": "A test and measurement app for Digilent instruments on macOS.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Finn Sheng",
  "scripts": {
    "predev": "node scripts/dev-app-name.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "screenshot": "electron-vite build && xvfb-run -a node scripts/screenshot.mjs screenshots"
  },
  "devDependencies": {
    "@robcholz/geist": "file:../Geist",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  }
}
