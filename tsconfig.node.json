{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"],
    "outDir": "out/tsc-node"
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/sim/spectrum.ts", "src/renderer/src/sim/dsp.ts", "libs/*/src/**/*", "libs/*/tests/**/*"]
}
